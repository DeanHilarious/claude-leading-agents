# claude-leading-agents 指挥台 nginx 反代示例
# 使用前替换：dashboard.example.com 与证书路径。
# 注意：本文件只是「新增一个 server 块」，不要改动服务器上已有的其他站点；
#       任何修改先 nginx -t 验证再 reload。
#
# 限流定义放在 http {} 级别（只加一次，勿与已有定义重名）
# limit_req_zone $binary_remote_addr zone=cla_login:10m rate=10r/m;
# limit_req_zone $binary_remote_addr zone=cla_ingest:10m rate=600r/m;

server {
    listen 80;
    server_name dashboard.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name dashboard.example.com;

    # 证书路径（占位，按实际替换）
    ssl_certificate     /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;

    # 上报单文件上限 2MB，留些头部余量
    client_max_body_size 3m;

    location = /login {
        limit_req zone=cla_login burst=20 nodelay;
        include /etc/nginx/claude-leading-agents/proxy_params;
    }

    location /ingest/ {
        limit_req zone=cla_ingest burst=600 nodelay;
        include /etc/nginx/claude-leading-agents/proxy_params;
    }

    location / {
        include /etc/nginx/claude-leading-agents/proxy_params;
    }
}

# /etc/nginx/claude-leading-agents/proxy_params 内容：
#   proxy_pass http://127.0.0.1:4177;
#   proxy_http_version 1.1;
#   proxy_set_header Connection '';
#   # SSE 必需：关闭缓冲、拉长读超时
#   proxy_buffering off;
#   proxy_read_timeout 3600s;
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
