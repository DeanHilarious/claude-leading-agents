# claude-leading-agents 指挥台环境变量（远程模式）
# 安装：cp 到 /etc/claude-leading-agents/dashboard.env 并 chmod 600
# 下面全部留空，请部署时填入自己的值；不要把真实值提交进仓库。

# 观看者登录密码（必填）
DASHBOARD_PASSWORD=

# 接收接口令牌（必填，至少 24 字符；reporter 上报时用同一个值）
DASHBOARD_INGEST_TOKEN=

# 对外域名（传给 --allowed-host，可逗号分隔多个；须与 nginx server_name 一致）
DASHBOARD_HOST=

# 数据目录磁盘配额（字节，默认 2147483648 = 2GB）
DASHBOARD_MAX_BYTES=

# 会话签名密钥（可选；不设则自动生成并保存在 DATA/.session-secret）
# DASHBOARD_SESSION_SECRET=
